<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Запрошення</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Tenor+Sans&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#f8efe4;        /* теплий кремовий — текст */
  --cream-2:#ecdcc8;
  --peach:#e3c98f;        /* м'яке шампань-золото */
  --peach-deep:#ecd2a0;   /* світле пастельне золото — акценти */
  --mocha:#dcc08a;        /* приглушене пастельне золото */
  --ink:#f8efe4;          /* основний текст — теплий кремовий */
  --ink-soft:#e3cdb2;     /* приглушений світлий */
  --blush:#e7b9c4;        /* пастельний рожевий */
  --boy:#a9c9dd;          /* пастельний блакитний */
  --girl:#eab8c8;         /* пастельний рожевий */
  --line:rgba(236,210,160,.30);
  --wine:#5a2236;         /* м'якший винний фон */
  --wine-2:#6b2c42;       /* світліший винний */
  --wine-3:#46182a;       /* темніший винний */
  --gold:#ecd2a0;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Tenor Sans',serif;
  color:var(--ink);
  background:var(--wine);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  line-height:1.65;
}
.wrap{max-width:560px;margin:0 auto;position:relative;background:var(--wine);box-shadow:0 0 80px rgba(0,0,0,.4)}
.serif{font-family:'Cormorant Garamond',serif}
.script{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500}

/* grain + glow overlay */
.wrap::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:50;
  background:radial-gradient(120% 50% at 50% 0%, rgba(217,184,94,.10), rgba(217,184,94,0) 70%);
  mix-blend-mode:screen;opacity:.7;max-width:560px;margin:0 auto;left:0;right:0;
}

/* ---------- COVER / ENVELOPE ---------- */
.cover{
  min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:32px 26px;position:relative;overflow:hidden;
  background:radial-gradient(140% 90% at 50% 12%, #7a3149 0%, #5a2236 45%, #46182a 100%);
}
.env-stage{position:relative;width:100%;max-width:360px;perspective:1400px}

/* the envelope (shown first) */
.envelope{position:relative;width:100%;aspect-ratio:7/5;cursor:pointer;transition:transform .8s ease, opacity .8s ease}
.env-body{position:absolute;inset:0;border-radius:12px;
  background:linear-gradient(160deg,#7a3149,#5a2236);
  box-shadow:0 26px 55px rgba(122,86,60,.28), inset 0 0 0 1px rgba(255,255,255,.35);}
.env-pocket{position:absolute;inset:0;border-radius:12px;overflow:hidden}
.env-pocket::before{content:"";position:absolute;left:0;bottom:0;width:100%;height:62%;
  background:linear-gradient(180deg,#6b2c42,#522036);clip-path:polygon(0 38%,50% 100%,100% 38%,100% 100%,0 100%);}
.env-flap{position:absolute;left:0;top:0;width:100%;height:60%;transform-origin:top center;
  background:linear-gradient(180deg,#86374f,#6b2c42);clip-path:polygon(0 0,100% 0,50% 100%);
  z-index:6;transition:transform 1s cubic-bezier(.6,.05,.25,1);box-shadow:0 6px 12px rgba(122,86,60,.12);}
.env-seal{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);z-index:8;
  width:84px;height:84px;border-radius:50%;
  background:radial-gradient(circle at 38% 32%,#f3e3bd,#e3c98f 55%,#c2a05a);
  box-shadow:0 12px 26px rgba(0,0,0,.45),inset 0 2px 6px rgba(255,255,255,.4),inset 0 -7px 12px rgba(120,90,20,.45);
  display:flex;align-items:center;justify-content:center;transition:transform .6s ease, opacity .5s ease;}
.env-seal::after{content:"";position:absolute;inset:8px;border-radius:50%;border:1px dashed rgba(80,55,10,.5)}
.env-seal span{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:27px;color:#4a0f1c;text-shadow:0 1px 1px rgba(255,255,255,.3)}
.env-hint{position:absolute;left:0;right:0;bottom:-46px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--mocha);opacity:.75;animation:bob 2s ease-in-out infinite}

/* the card that rises out */
.env-card{position:absolute;left:6%;top:8%;width:88%;z-index:5;
  background:linear-gradient(180deg,#7a314960,#5a2236) , linear-gradient(180deg,#7a3149,#5e2438);border:1px solid rgba(236,210,160,.55);
  border-radius:12px;padding:34px 22px 30px;box-shadow:0 20px 40px rgba(0,0,0,.45),inset 0 0 0 1px rgba(217,184,94,.15);
  opacity:0;transform:translateY(40px) scale(.96);transition:transform 1s .35s cubic-bezier(.2,.8,.2,1), opacity .8s .35s ease;}
.env-card .guest-greet{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(22px,6vw,28px);color:var(--peach-deep);margin-bottom:10px;line-height:1.2;display:none}
.env-card .guest-greet.show{display:block}
.env-card .eyebrow{font-size:11px;letter-spacing:.4em;text-transform:uppercase;color:var(--mocha);margin-bottom:14px}
.env-card h1{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(38px,12vw,56px);line-height:.98;color:var(--ink)}
.env-card .amp{display:block;font-style:italic;font-size:.6em;color:var(--peach-deep);margin:2px 0}
.env-card .ornline{width:46px;height:1px;background:var(--mocha);opacity:.45;margin:14px auto}
.env-card .meta{margin-top:6px}
.env-card .meta .d{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:26px;color:var(--peach-deep);line-height:1.15}
.env-card .meta .row{font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin-top:8px}
.env-card .sub{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--mocha);margin-top:16px}

/* OPENED state */
.cover.open .env-flap{transform:rotateX(178deg);z-index:1}
.cover.open .env-seal{transform:translate(-50%,-50%) scale(.5);opacity:0}
.cover.open .env-card{opacity:1;transform:translateY(-26%) scale(1)}
.cover.open .env-hint{opacity:0}
.cover.open .envelope{cursor:default}
.cover.open .env-stage{padding-bottom:60px}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}

.cover .scroll{margin:38px auto 0;font-size:12px;letter-spacing:.26em;text-transform:uppercase;color:#5a2236;font-weight:600;opacity:0;transition:opacity .6s 1.3s ease;display:flex;flex-direction:column;align-items:center;gap:6px;background:linear-gradient(180deg,#f3e3bd,#e3c98f);padding:10px 22px 8px;border-radius:30px;box-shadow:0 8px 22px rgba(0,0,0,.35);border:1px solid rgba(232,205,134,.6)}
.cover .scroll .arrow{font-size:18px;line-height:1}
.cover.open .scroll{opacity:1;animation:bobY 1.6s 1.3s ease-in-out infinite}
@keyframes bobY{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}

/* reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s ease, transform .9s cubic-bezier(.2,.8,.2,1)}
.reveal.in{opacity:1;transform:none}

/* ---------- SECTIONS ---------- */
section{padding:74px 34px;position:relative}
.kicker{font-size:12px;letter-spacing:.4em;text-transform:uppercase;color:var(--peach-deep);text-align:center;margin-bottom:14px}
.title{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:clamp(34px,9vw,46px);text-align:center;color:var(--ink);line-height:1.05;margin-bottom:10px}
.lead{text-align:center;color:var(--ink-soft);font-size:15.5px;max-width:420px;margin:0 auto}
.divider{width:46px;height:1px;background:var(--peach-deep);opacity:.6;margin:18px auto 0}

/* hero photo */
.photo{position:relative}
.photo .frame{
  border-radius:200px 200px 14px 14px;overflow:hidden;
  box-shadow:0 24px 50px rgba(0,0,0,.45);
  border:2px solid rgba(217,184,94,.45);
}
.photo img{width:100%;display:block}
.photo .cap{text-align:center;margin-top:22px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;color:var(--mocha)}
.bigdate{text-align:center;margin-top:40px;padding:30px 24px;background:linear-gradient(180deg,#6b2c42,#522036);border:1px solid var(--line);border-radius:18px;box-shadow:inset 0 0 0 1px rgba(217,184,94,.12)}
.bigdate .day{font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(54px,18vw,82px);line-height:.9;color:var(--ink)}
.bigdate .month{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(26px,7vw,34px);color:var(--peach-deep);margin-top:4px}
.bigdate .yr{font-size:13px;letter-spacing:.42em;text-transform:uppercase;color:var(--ink-soft);margin-top:10px}
.bigdate .sep{width:46px;height:1px;background:var(--peach-deep);opacity:.5;margin:18px auto}
.bigdate .time{font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(34px,11vw,46px);color:var(--ink);line-height:1}
.bigdate .time-lab{font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--mocha);margin-top:8px}

/* timeline */
.tl{position:relative;margin-top:40px}
.tl::before{content:"";position:absolute;left:63px;top:10px;bottom:10px;width:2px;background:var(--line);transform:translateX(-50%)}
.tl .item{display:flex;gap:20px;align-items:flex-start;margin-bottom:30px;position:relative}
.tl .time{font-family:'Cormorant Garamond',serif;font-weight:600;font-size:22px;color:var(--peach-deep);width:56px;text-align:right;flex-shrink:0;padding-top:2px}
.tl .dot{position:absolute;left:63px;top:11px;width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 38% 32%,#f3e3bd,#e3c98f 70%,#c2a05a);border:2px solid var(--wine);box-shadow:0 0 0 1px rgba(236,210,160,.5),0 0 10px rgba(236,210,160,.35);z-index:2;transform:translateX(-50%)}
.tl .c{flex:1;padding-left:24px}
.tl .c h3{font-family:'Tenor Sans';font-size:16px;letter-spacing:.04em;color:var(--ink);margin-bottom:3px}
.tl .c p{font-size:14px;color:var(--ink-soft)}

/* card */
.card{background:linear-gradient(180deg,#6b2c42,#522036);border:1px solid var(--line);border-radius:18px;padding:30px 26px;text-align:center;margin-top:30px;box-shadow:inset 0 0 0 1px rgba(217,184,94,.12)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;
  font-family:'Tenor Sans';font-size:13.5px;letter-spacing:.14em;text-transform:uppercase;
  padding:15px 30px;border-radius:40px;text-decoration:none;cursor:pointer;border:none;transition:.25s;
}
.btn-primary{background:linear-gradient(180deg,#f3e3bd,#e3c98f);color:#5a2236;box-shadow:0 8px 20px rgba(0,0,0,.3)}
.btn-primary:active{transform:scale(.97)}
.btn-out{background:transparent;color:var(--gold);border:1px solid var(--gold)}

/* dress-code palette */
.palette{display:flex;flex-wrap:wrap;justify-content:center;gap:22px;margin-top:30px}
.palette .sw{display:flex;flex-direction:column;align-items:center;gap:9px;width:72px}
.palette .ring{width:48px;height:48px;border-radius:50%;box-shadow:0 6px 16px rgba(0,0,0,.28),inset 0 -4px 8px rgba(0,0,0,.08),inset 0 2px 4px rgba(255,255,255,.5);border:2px solid rgba(248,239,228,.25)}
.palette .nm{font-size:11px;letter-spacing:.08em;color:var(--ink-soft);text-align:center;line-height:1.3}

/* gift */
.gift .card p{font-size:15.5px;color:var(--ink-soft);margin-bottom:8px}
.gift .big{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:28px;color:var(--mocha);margin:6px 0 4px}

/* gender lottery */
.lot .cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
.lcard{border-radius:20px;padding:26px 18px 24px;text-align:center;position:relative;overflow:hidden;border:1px solid rgba(217,184,94,.25);box-shadow:0 14px 30px rgba(0,0,0,.4)}
.lcard.boy{background:linear-gradient(180deg,#6b2c42,#532138);border:1px solid rgba(127,168,196,.4)}
.lcard.girl{background:linear-gradient(180deg,#6b2c42,#532138);border:1px solid rgba(217,143,166,.45)}
.lcard .emo{font-size:34px;margin-bottom:6px}
.lcard h3{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:30px;color:var(--ink);margin-bottom:2px}
.lcard .lab{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:16px}
.votes{font-family:'Cormorant Garamond',serif;font-size:40px;font-weight:600;color:var(--ink);line-height:1;margin-bottom:2px}
.votes-lab{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:16px}
.lbtn{display:inline-block;width:100%;border:none;border-radius:30px;padding:14px 0;font-family:'Tenor Sans';font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;color:#fff;transition:.25s;text-align:center;text-decoration:none;box-sizing:border-box}
.lcard.boy .lbtn{background:#6f97b0}
.lcard.girl .lbtn{background:#cf8a9d}
.lbtn:active{transform:scale(.96)}
.lbtn:disabled{cursor:default}
.lcard.boy .lbtn.voted{background:linear-gradient(180deg,#f3e3bd,#e3c98f);color:#5a2236}
.lcard.girl .lbtn.voted{background:linear-gradient(180deg,#f3e3bd,#e3c98f);color:#5a2236}
.barwrap{height:8px;border-radius:8px;background:rgba(255,255,255,.12);overflow:hidden;margin-top:26px;display:flex}
.bar-boy{background:#6f97b0;transition:width .6s cubic-bezier(.2,.8,.2,1)}
.bar-girl{background:#d590a0;transition:width .6s cubic-bezier(.2,.8,.2,1)}
.lot .note{text-align:center;font-size:12.5px;color:var(--ink-soft);margin-top:14px;font-style:italic;font-family:'Cormorant Garamond',serif;font-size:16px}

/* location */
.loc .card p{font-size:16px;color:var(--ink);margin-bottom:4px}
.loc .addr{font-family:'Cormorant Garamond',serif;font-size:22px;font-style:italic;color:var(--mocha);margin:8px 0 22px;line-height:1.3}

/* footer */
.foot{text-align:center;padding:56px 34px 70px;background:linear-gradient(180deg,#522036,#46182a)}
.foot .seal2{width:74px;height:74px;border-radius:50%;margin:0 auto 22px;background:radial-gradient(circle at 38% 32%, #f3e3bd, #e3c98f 55%, #c2a05a);box-shadow:0 10px 22px rgba(0,0,0,.4),inset 0 -6px 10px rgba(120,90,20,.4);display:flex;align-items:center;justify-content:center}
.foot .seal2 span{font-family:'Cormorant Garamond';font-style:italic;font-size:24px;color:#4a0f1c}
.foot h2{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:34px;color:var(--ink)}
.foot p{font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft);margin-top:10px}

.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(120px);background:#6b2c42;color:var(--gold);border:1px solid rgba(217,184,94,.4);padding:13px 24px;border-radius:40px;font-size:13px;letter-spacing:.08em;z-index:99;transition:transform .4s cubic-bezier(.2,.8,.2,1);box-shadow:0 12px 30px rgba(0,0,0,.45);max-width:90%;text-align:center}
.toast.show{transform:translateX(-50%) translateY(0)}
</style>
</head>
<body>
<div class="wrap">

  <!-- COVER / ENVELOPE -->
  <header class="cover" id="cover">
    <div class="env-stage">
      <div class="env-card">
        <div class="guest-greet" id="guestGreet"></div>
        <div class="eyebrow">Запрошення</div>
        <h1 class="serif">Дарʼя<span class="amp serif">&</span>Леонід</h1>
        <div class="ornline"></div>
        <div class="meta">
          <div class="d">20.06.2026</div>
          <div class="row">17:10 · Київ</div>
          <div class="row" style="margin-top:4px">Берестейський, 42</div>
        </div>
        <div class="sub">Розпис · Гендер-паті</div>
      </div>
      <div class="envelope" id="envelope" role="button" tabindex="0" aria-label="Відкрити запрошення">
        <div class="env-body"></div>
        <div class="env-pocket"></div>
        <div class="env-flap"></div>
        <div class="env-seal"><span>Д&Л</span></div>
      </div>
      <div class="env-hint">натисніть, щоб відкрити</div>
    </div>
    <div class="scroll"><span>Гортайте вниз</span><span class="arrow">↓</span></div>
  </header>

  <!-- INVITE / PHOTO -->
  <section class="photo reveal">
    <div class="kicker">Ви запрошені</div>
    <div class="title">Ми одружуємось</div>
    <div class="lead">...і ділимося з вами нашою радістю, нашим спільним моментом. Будемо щасливі бачити вас поруч у цей особливий день.</div>
    <div class="divider"></div>
    <div class="frame" style="margin-top:34px"><img src="data:image/jpeg;base64," alt="Пара"></div>
    <div class="bigdate">
      <div class="day">20</div>
      <div class="month serif">червня</div>
      <div class="yr">2026</div>
      <div class="sep"></div>
      <div class="time">17:10</div>
      <div class="time-lab">збір гостей</div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="reveal">
    <div class="kicker">Програма дня</div>
    <div class="title">Як усе пройде</div>
    <div class="divider"></div>
    <div class="tl">
      <div class="item"><div class="time">17:10</div><div class="dot"></div><div class="c"><h3>Збір гостей</h3><p>Зустрічаємось біля локації, робимо фото й заходимо до зали.</p></div></div>
      <div class="item"><div class="time">17:30</div><div class="dot"></div><div class="c"><h3>Церемонія</h3><p>Початок урочистого розпису.</p></div></div>
      <div class="item"><div class="time">18:00</div><div class="dot"></div><div class="c"><h3>Спільне фото</h3><p>Робимо фото всі разом у парку Пушкіна.</p></div></div>
      <div class="item"><div class="time">18:30</div><div class="dot"></div><div class="c"><h3>Ресторан</h3><p>Святкуємо разом — частування, музика й гарний настрій.</p></div></div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="loc reveal">
    <div class="kicker">Локація</div>
    <div class="title">Де ми зустрінемось</div>
    <div class="divider"></div>
    <div class="card">
      <p>Київ</p>
      <div class="addr">Берестейський проспект, 42</div>
      <a class="btn btn-primary" href="https://share.google/x84fvbL8a8AkfumlH" target="_blank" rel="noopener">Прокласти маршрут</a>
    </div>
  </section>

  <!-- DRESS CODE -->
  <section class="reveal">
    <div class="kicker">Дрес-код</div>
    <div class="title">Вільний або класичний</div>
    <div class="lead">Жодних суворих правил — оберіть те, у чому почуваєтесь вільно й святково. Невимушений чи класичний образ — обидва доречні. Якщо хочете влучити в настрій свята — ось наша гама теплих нюдових відтінків:</div>
    <div class="palette">
      <div class="sw"><div class="ring" style="background:#f7f1e8"></div><div class="nm">Молочний</div></div>
      <div class="sw"><div class="ring" style="background:#efe4d3"></div><div class="nm">Ванільний</div></div>
      <div class="sw"><div class="ring" style="background:#e6d3bb"></div><div class="nm">Пісочний</div></div>
      <div class="sw"><div class="ring" style="background:#d8bf9f"></div><div class="nm">Бежевий</div></div>
      <div class="sw"><div class="ring" style="background:#c6a884"></div><div class="nm">Карамель</div></div>
      <div class="sw"><div class="ring" style="background:#b08d68"></div><div class="nm">Капучино</div></div>
    </div>
    <div class="divider"></div>
  </section>

  <!-- GIFT -->
  <section class="gift reveal">
    <div class="kicker">Подарунок</div>
    <div class="title">Кілька слів</div>
    <div class="divider"></div>
    <div class="card">
      <p>Якщо ви захочете привітати нас подарунком —</p>
      <div class="big">найкращий подарунок для нас це гроші</div>
      <p>Дякуємо вам за турботу й любов.</p>
    </div>
  </section>

  <!-- GENDER LOTTERY -->
  <section class="lot reveal">
    <div class="kicker">Гендер-паті</div>
    <div class="title">Хлопчик чи дівчинка?</div>
    <div class="lead">Зробіть ставку — хто ж у нас буде? У кожної команди є своя банка monobank: закиньте будь-який грошик у ту, на яку ставите. А якщо даруєте готівкою — все одно натисніть на банку, щоб ваш голос зарахувався. Лічильник покаже, скільки гостей за кожну команду, а на святі ми разом порахуємо, хто переміг.</div>
    <div class="cards">
      <div class="lcard boy">
        <div class="emo">👶🩵</div>
        <h3>Хлопчик</h3>
        <div class="lab">Банка для ставок</div>
        <div class="votes" id="vBoy">0</div>
        <div class="votes-lab">підтримали</div>
        <a class="lbtn vbtn" data-team="boy" href="#" target="_blank" rel="noopener">Закинути грошик</a>
      </div>
      <div class="lcard girl">
        <div class="emo">👶🩷</div>
        <h3>Дівчинка</h3>
        <div class="lab">Банка для ставок</div>
        <div class="votes" id="vGirl">0</div>
        <div class="votes-lab">підтримали</div>
        <a class="lbtn vbtn" data-team="girl" href="#" target="_blank" rel="noopener">Закинути грошик</a>
      </div>
    </div>
    <div class="barwrap"><div class="bar-boy" id="barBoy" style="width:50%"></div><div class="bar-girl" id="barGirl" style="width:50%"></div></div>
  </section>

  <!-- FOOTER -->
  <footer class="foot reveal">
    <div class="seal2"><span>Д&Л</span></div>
    <h2 class="serif">До зустрічі</h2>
    <p>20 червня 2026 · Київ</p>
  </footer>

</div>

<div class="toast" id="toast"></div>

<script>
// personalized greeting from URL: ?guests=Олено%20та%20Брониславе
(function(){
  try{
    const params=new URLSearchParams(window.location.search);
    const g=params.get('guests')||params.get('guest');
    const el=document.getElementById('guestGreet');
    if(g&&g.trim()){
      el.textContent=g.trim()+', раді бачити вас';
      el.classList.add('show');
    } else {
      // demo example — replace by adding ?guests=Імена to the link
      el.textContent='Олено та Брониславе, раді бачити вас';
      el.classList.add('show');
    }
  }catch(e){/* no params */}
})();

// envelope open
const cover=document.getElementById('cover'),envelope=document.getElementById('envelope');
let opened=false;
function openEnvelope(){if(opened)return;opened=true;cover.classList.add('open');}
envelope.addEventListener('click',openEnvelope);
envelope.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openEnvelope()}});

// reveal on scroll
const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// === ПОСИЛАННЯ НА БАНКИ ===
// Замініть '#' на справжні monobank-посилання своїх банок:
const JAR_LINKS = {
  boy:  'https://send.monobank.ua/jar/3Pn3SuUzyw',   // банка "Хлопчик" (блакитна)
  girl: 'https://send.monobank.ua/jar/3JD8MC8adp'    // банка "Дівчинка" (рожева)
};

// Real shared vote counter (persists across sessions, shared between guests)
let votes={boy:0,girl:0};
let myVote=null;
let busy=false;
const vBoy=document.getElementById('vBoy'),vGirl=document.getElementById('vGirl');
const barBoy=document.getElementById('barBoy'),barGirl=document.getElementById('barGirl');
const toast=document.getElementById('toast');let toastT;
function showToast(m){toast.textContent=m;toast.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>toast.classList.remove('show'),2600)}
function render(){
  vBoy.textContent=votes.boy;vGirl.textContent=votes.girl;
  const t=votes.boy+votes.girl;
  const b=t?Math.round(votes.boy/t*100):50;
  barBoy.style.width=b+'%';barGirl.style.width=(100-b)+'%';
  document.querySelectorAll('.lbtn').forEach(b=>{
    const team=b.dataset.team;
    if(myVote===team){b.classList.add('voted');b.textContent='Грошик закинуто ✓'}
    else{b.classList.remove('voted');b.textContent='Закинути грошик'}
  });
}

const STORE=window.storage;

async function loadVotes(){
  if(!STORE)return; // fallback: in-memory only (e.g. opened as plain file)
  try{
    const r=await STORE.get('gender:tally',true);
    if(r&&r.value){const v=JSON.parse(r.value);votes.boy=v.boy||0;votes.girl=v.girl||0}
  }catch(e){/* no votes yet */}
  try{
    const m=await STORE.get('gender:myvote',false); // personal, per device
    if(m&&m.value){myVote=m.value}
  }catch(e){/* not voted yet */}
  render();
}

async function castVote(team){
  if(busy||myVote)return; // зараховуємо лише один раз з пристрою
  busy=true;
  myVote=team;votes[team]++;render();
  showToast(team==='boy'?'Дякуємо! Ваш голос — за хлопчика 🩵':'Дякуємо! Ваш голос — за дівчинку 🩷');
  if(STORE){
    try{
      // re-read latest shared tally to reduce overwrite, then save
      try{const r=await STORE.get('gender:tally',true);if(r&&r.value){const v=JSON.parse(r.value);votes.boy=(v.boy||0);votes.girl=(v.girl||0);votes[team]++;render()}}catch(e){}
      await STORE.set('gender:tally',JSON.stringify({boy:votes.boy,girl:votes.girl}),true);
      await STORE.set('gender:myvote',team,false);
    }catch(e){console.error('vote save failed',e)}
  }
  busy=false;
}

document.querySelectorAll('.lbtn').forEach(btn=>{
  const team=btn.dataset.team;
  const link=JAR_LINKS[team]||'#';
  btn.setAttribute('href',link);
  btn.addEventListener('click',(e)=>{
    // зараховуємо голос; якщо банка ще не вказана (#) — не переходимо
    if(link==='#'){e.preventDefault();}
    castVote(team);
  });
});

loadVotes();

</script>
</body>
</html>
